{
  "expo": {
    "name": "SecureBank",
    "slug": "securebank",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "securebank",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A192F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.securebank.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Aparat jest wymagany do skanowania kodów QR z danymi przelewu."
      }
    },
    "android": {
      "package": "com.securebank.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A192F"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-asset"
    ]
  }
}
