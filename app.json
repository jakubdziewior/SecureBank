{
  "expo": {
    "name": "SecureBank",
    "slug": "securebank",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "securebank",
    "platforms": ["ios", "android", "web"],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A192F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.securebank.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Aparat jest wymagany do skanowania kodów QR z danymi przelewu.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSPinnedDomains": {
            "supabase.co": {
              "NSIncludesSubdomains": true,
              "NSPinnedCAIdentities": [
                {
                  "SPKI-SHA256-BASE64": "kIdp6NNEd8wsugYyyIYFsi1ylMCED3hZbSR8ZFsa/A4="
                },
                {
                  "SPKI-SHA256-BASE64": "mEflZT5enoR1FuXLgYYGqnVEoZvmf9c2bVBpiOjYQ0c="
                },
                {
                  "SPKI-SHA256-BASE64": "hxqRlPTu1bMS/0DITB1SSu0vd4u/8l8TjPgfaAp63Gc="
                }
              ]
            }
          }
        }
      }
    },
    "android": {
      "package": "com.securebank.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A192F"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aparat jest wymagany do skanowania kodów QR z danymi przelewu.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "./plugins/withNetworkSecurityConfig.js",
      "./plugins/withAndroidHardening.js"
    ]
  }
}
